<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- DRAFT, not usable yet: `farpane-server service run` does not exist on macOS.
       Install as /Library/LaunchDaemons/io.github.pierrejochem.farpane.server.plist,
       owned by root:wheel, mode 644 (launchd refuses anything else).
       The daemon keeps the network, accounts and policy (design reference, section 19);
       the screen is the agent's job. -->
  <key>Label</key><string>io.github.pierrejochem.farpane.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Farpane Server.app/Contents/MacOS/farpane-server</string>
    <string>service</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardErrorPath</key><string>/var/log/farpane-server.log</string>
  <key>StandardOutPath</key><string>/var/log/farpane-server.log</string>
</dict>
</plist>
