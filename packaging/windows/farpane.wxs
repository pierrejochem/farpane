<!--
  WiX v5 installer for Farpane Viewer + Farpane Server.
  Build: wix build packaging\windows\farpane.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Firewall.wixext
         -d Version=0.3.0 -d BinDir=target\x86_64-pc-windows-msvc\release -o farpane.msi
  UpgradeCode must NEVER change after the first public release: it is what
  lets a new MSI replace an older install.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">
  <Package Name="Farpane" Manufacturer="Pierre Jochem" Version="$(var.Version)"
           UpgradeCode="BBBEFBBD-EBED-4FEB-A517-ED16B14CFF56" Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Farpane is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="FarpaneViewer.ico" SourceFile="$(sys.SOURCEFILEDIR)..\icons\farpane-viewer.ico" />
    <Icon Id="FarpaneServer.ico" SourceFile="$(sys.SOURCEFILEDIR)..\icons\farpane-server.ico" />
    <Property Id="ARPPRODUCTICON" Value="FarpaneViewer.ico" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Farpane">
        <Component Id="ViewerExe">
          <File Id="ViewerExeFile" Source="$(var.BinDir)\farpane-viewer.exe" KeyPath="yes" />
          <!-- vnc:// links open in the viewer -->
          <RegistryKey Root="HKLM" Key="Software\Classes\vnc">
            <RegistryValue Type="string" Value="URL:VNC Protocol" />
            <RegistryValue Name="URL Protocol" Type="string" Value="" />
            <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[#ViewerExeFile]&quot; &quot;%1&quot;" />
          </RegistryKey>
        </Component>
        <Component Id="ServerExe">
          <File Id="ServerExeFile" Source="$(var.BinDir)\farpane-server.exe" KeyPath="yes" />
          <!-- Allows the server program through Windows Firewall (private + domain profiles). -->
          <fw:FirewallException Id="ServerFirewallPrivate" Name="Farpane Server (private networks)" Program="[#ServerExeFile]"
                                Profile="private" Scope="any" />
          <fw:FirewallException Id="ServerFirewallDomain" Name="Farpane Server (domain networks)" Program="[#ServerExeFile]"
                                Profile="domain" Scope="any" />
          <!-- The service runs as LocalSystem and starts when asked (`sc start FarpaneServer`);
               `farpane-server service install` with the auto option switches it to boot time. It shares
               the console session's screen through a session worker it starts, see the handbook. -->
          <ServiceInstall Id="FarpaneServerService" Name="FarpaneServer" DisplayName="Farpane Server"
                          Description="Farpane Server: VNC-compatible remote desktop server"
                          Type="ownProcess" Start="demand" ErrorControl="normal"
                          Arguments="service run" Vital="no" />
          <ServiceControl Id="FarpaneServerControl" Name="FarpaneServer" Stop="both" Remove="uninstall" Wait="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuDir" Name="Farpane">
        <Component Id="Shortcuts">
          <Shortcut Id="ViewerShortcut" Name="Farpane Viewer" Target="[#ViewerExeFile]" WorkingDirectory="INSTALLFOLDER" Icon="FarpaneViewer.ico" />
          <Shortcut Id="ServerShortcut" Name="Farpane Server" Target="[#ServerExeFile]" WorkingDirectory="INSTALLFOLDER" Icon="FarpaneServer.ico" />
          <RemoveFolder Id="RemoveStartMenuDir" On="uninstall" />
          <RegistryValue Root="HKLM" Key="Software\Farpane" Name="Shortcuts" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="Farpane" Level="1">
      <ComponentRef Id="ViewerExe" />
      <ComponentRef Id="ServerExe" />
      <ComponentRef Id="Shortcuts" />
    </Feature>

    <ui:WixUI Id="WixUI_Minimal" />
  </Package>
</Wix>
