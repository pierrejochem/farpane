[Unit]
Description=Farpane remote desktop server (headless, current user session)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# --headless: no dashboard window. --desktop: share this session's desktop
# (Wayland through the portal, else X11).
ExecStart=/usr/bin/farpane-server --headless --desktop
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
